{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@config/*": ["./config/*"],
      "@core/*": ["./core/*"],
      "@drivers/*": ["./drivers/*"],
      "@pages/*": ["./pages/*"],
      "@evaluations/*": ["./evaluations/*"],
      "@test-data/*": ["./test-data/*"],
      "@reporters/*": ["./reporters/*"],
      "@utils/*": ["./utils/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
