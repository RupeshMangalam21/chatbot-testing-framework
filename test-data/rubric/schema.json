{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rubric Test Case",
  "type": "object",
  "required": ["id","title","prompts","expected"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "prompts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "expected": {
      "type": "object",
      "properties": {
        "required_phrases": { "type": "array", "items": { "type": "string" } },
        "forbidden_phrases": { "type": "array", "items": { "type": "string" } },
        "auth_required": { "type": "boolean" },
        "roles_allowed": { "type": "array", "items": { "type": "string" } },
        "semantic_intents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "alternatives"],
            "properties": {
              "name": { "type": "string" },
              "alternatives": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "required": { "type": "boolean" },
              "weight": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "policy_checks": {
      "type": "object",
      "properties": {
        "must_include_all": { "type": "array", "items": { "type": "string" } },
        "must_include_any": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "must_not_include": { "type": "array", "items": { "type": "string" } },
        "refusal_required_for_prompt_terms": { "type": "array", "items": { "type": "string" } },
        "refusal_markers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auto_check": { "type": "object" },
    "manual_review": { "type": "boolean" }
  }
}
